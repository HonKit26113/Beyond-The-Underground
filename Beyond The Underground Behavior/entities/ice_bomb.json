{
  "format_version": "1.12.0",
  "minecraft:entity": {
    "description": {
      "identifier": "honkit26113:ice_bomb_projectile",
      "runtime_identifier": "minecraft:snowball",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "honkit26113:despawn": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:collision_box": {
        "width": 0.25,
        "height": 0.25
      },
      "minecraft:projectile": {
        "on_hit": {
          "impact_damage": {
            "damage": 1,
            "knockback": false
          },
          //"remove_on_hit": {},
          "definition_event": {
            "affect_projectile": true,
            "event_trigger": {
              "target": "self",
              "event": "hit_ground"
            }
          }
        },
        "power": 1.5,
        "gravity": 0.03,
        "angle_offset": 0.0,
        "hit_sound": "dig.sand"
      },
	    "minecraft:physics": {
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": true
      }
    },
    "events": {
      "hit_ground": {
        "add": {
          "component_groups": [
            "honkit26113:despawn"
          ]
        }
      }
    }
  }
}


