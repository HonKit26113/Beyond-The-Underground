{
	"format_version": "1.16.0",
	"minecraft:entity": {
		"description": {
			"identifier": "honkit26113:arena_monster_placeholder",
			"is_summonable": true,
			"is_spawnable": false,
			"is_experimental": false,
			"properties": {
				// Add to the array of values for every new mob appearing in battle
				"honkit26113:monster_type": {
					"type": "enum",
					"default": "honkit26113_scorpion",
					"values": ["honkit26113_scorpion", "honkit26113_sandy_skelly", "honkit26113_frost_spirit", "minecraft_stray", "honkit26113_ice_bomber"],
					"client_sync": true
				}
			}
		},
		"component_groups": {
			"honkit26113:countdown": {
				"minecraft:timer": {
					"looping": false,
					"time": [
						2,
						2
					],
					"time_down_event": {
						"event": "honkit26113:despawn"
					}
				}
			},
			"honkit26113:despawn": {
				"minecraft:instant_despawn": {}
			}
		},
		"components": {
			"minecraft:type_family": {
				"family": [ "placeholder", "inanimate" ]
			},
			"minecraft:collision_box": {
				"width": 0.03,
				"height": 0.5
			},
			"minecraft:fire_immune": true,
			"minecraft:persistent": {},
			"minecraft:physics": {},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
      		"minecraft:damage_sensor": {
        		"triggers": {
          			"cause": "all",
          			"deals_damage": false
        		}
      		}
		},
		"events": {
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": [
						"honkit26113:countdown"
					]
				}
			},
			"honkit26113:despawn": {
				"add": {
					"component_groups": [
						"honkit26113:despawn"
					]
				}
			}
		}
	}
}