{
	"format_version": "1.20.20",
	"minecraft:block": {
		"description": {
			"identifier": "honkit26113:crooked_door_top_flipped",
			"menu_category": {
				"category": "none",
				"group": "none"
			},
			"states": {
				"honkit26113:is_open": [ false, true ],
				"honkit26113:direction": [ 0, 1, 2, 3 ]
			}
		},
		"components": {
      		"tag:honkit26113_dig_with_axe": {},
			"tag:honkit26113_template_door_flipped": {},
			"tag:honkit26113_template_door_top": {},
			"tag:door": {},
			"minecraft:material_instances": {
				"*": {
					"texture": "crooked_door_top",
					"render_method": "blend",
					"face_dimming": true,
					"ambient_occlusion": false
				}
			},
			"minecraft:placement_filter": {
				"conditions": [
					{
						"allowed_faces": [ "up" ],
						"block_filter": [
							{
								"tags": "query.any_tag('honkit26113_template_door_flipped')"
							}
						]
					}
				]
			},
			"minecraft:flammable": {
				"destroy_chance_modifier": 45,
				"catch_chance_modifier": 80
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 0.5
			},
			"minecraft:on_player_destroyed": {
				"event": "honkit26113:player_borked"
			},
			"minecraft:geometry": { 
				"identifier": "geometry.bum_door_flipped", 
				"bone_visibility": { 
					"open": false ,
					"closed": false
				} 
			},
			"minecraft:loot": "loot_tables/no_drops.json",
			"minecraft:map_color": "#52221D",
			"minecraft:light_dampening": 0
		},
		"permutations": [{
				"condition": "q.block_state('honkit26113:direction') == 0",
				"components": {
					"minecraft:transformation": { "rotation": [0, 180, 0] }
				}
			},
			{
				"condition": "q.block_state('honkit26113:direction') == 1",
				"components": {
					"minecraft:transformation": { "rotation": [0, 0, 0] }
				}
			},
			{
				"condition": "q.block_state('honkit26113:direction') == 2",
				"components": {
					"minecraft:transformation": { "rotation": [0, 270, 0] }
				}
			},
			{
				"condition": "q.block_state('honkit26113:direction') == 3",
				"components": {
					"minecraft:transformation": { "rotation": [0, 90, 0] }
				}
			},
			{
				"condition": "q.block_state('honkit26113:is_open') == 0",
				"components": {
					"minecraft:on_interact": {
						"event": "honkit26113:open_door"
					},
					"minecraft:collision_box": {
						"origin": [-8, 0, -8],
						"size": [16, 16, 3]
					},
					"minecraft:selection_box": {
						"origin": [-8, 0, -8],
						"size": [16, 16, 3]
					},
					"minecraft:geometry": { 
						"identifier": "geometry.bum_door_flipped", 
						"bone_visibility": { 
							"open": false 
						} 
					},
					"tag:honkit26113:closed_template_door": {}
				}
			},
			{
				"condition": "q.block_state('honkit26113:is_open') == 1",
				"components": {
					"minecraft:on_interact": {
						"event": "honkit26113:close_door"
					},
					"minecraft:collision_box": {
						"origin": [5, 0, -8],
						"size": [3, 16, 16]
					},
					"minecraft:selection_box": {
						"origin": [5, 0, -8],
						"size": [3, 16, 16]
					},
					"minecraft:geometry": { 
						"identifier": "geometry.bum_door_flipped", 
						"bone_visibility": { 
							"closed": false
						} 
					},
					"tag:honkit26113:open_template_door": {}
				}
			}
		],
		"events": {
			"honkit26113:set_lower_block": {
				"sequence": [
					{
						"condition": "q.block_state('honkit26113:direction')==0&&q.block_state('honkit26113:is_open')==false",
						"run_command": {
							"command": [
								"setblock ~~-1~ honkit26113:template_door_bottom_flipped [\"honkit26113:direction\"=0, \"honkit26113:is_open\"=false, \"honkit26113:top_refresh\"=true]"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==1&&q.block_state('honkit26113:is_open')==false",
						"run_command": {
							"command": [
								"setblock ~~-1~ honkit26113:template_door_bottom_flipped [\"honkit26113:direction\"=1, \"honkit26113:is_open\"=false, \"honkit26113:top_refresh\"=true]"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==2&&q.block_state('honkit26113:is_open')==false",
						"run_command": {
							"command": [
								"setblock ~~-1~ honkit26113:template_door_bottom_flipped [\"honkit26113:direction\"=2, \"honkit26113:is_open\"=false, \"honkit26113:top_refresh\"=true]"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==3&&q.block_state('honkit26113:is_open')==false",
						"run_command": {
							"command": [
								"setblock ~~-1~ honkit26113:template_door_bottom_flipped [\"honkit26113:direction\"=3, \"honkit26113:is_open\"=false, \"honkit26113:top_refresh\"=true]"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==0&&q.block_state('honkit26113:is_open')==true",
						"run_command": {
							"command": [
								"setblock ~~-1~ honkit26113:template_door_bottom_flipped [\"honkit26113:direction\"=0, \"honkit26113:is_open\"=true, \"honkit26113:top_refresh\"=true]"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==1&&q.block_state('honkit26113:is_open')==true",
						"run_command": {
							"command": [
								"setblock ~~-1~ honkit26113:template_door_bottom_flipped [\"honkit26113:direction\"=1, \"honkit26113:is_open\"=true, \"honkit26113:top_refresh\"=true]"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==2&&q.block_state('honkit26113:is_open')==true",
						"run_command": {
							"command": [
								"setblock ~~-1~ honkit26113:template_door_bottom_flipped [\"honkit26113:direction\"=2, \"honkit26113:is_open\"=true, \"honkit26113:top_refresh\"=true]"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==3&&q.block_state('honkit26113:is_open')==true",
						"run_command": {
							"command": [
								"setblock ~~-1~ honkit26113:template_door_bottom_flipped [\"honkit26113:direction\"=3, \"honkit26113:is_open\"=true, \"honkit26113:top_refresh\"=true]"
							]
						}
					}
				]
			},
			"honkit26113:close_door": {
				"sequence": [{
						"run_command": {
							"command": [
								"playsound close.nether_wood_door @a[r=10] ~ ~ ~"
							]
						}
					},
					{
						"set_block_state": {
							"honkit26113:is_open": 0
						}
					},
					{
						"trigger": {
							"event": "honkit26113:set_lower_block",
							"target": "self"
						}
					}
				]
			},
			"honkit26113:open_door": {
				"sequence": [{
						"run_command": {
							"command": [
								"playsound open.nether_wood_door @a[r=10] ~ ~ ~"
							]
						}
					},
					{
						"set_block_state": {
							"honkit26113:is_open": 1
						}
					},
					{
						"trigger": {
							"event": "honkit26113:set_lower_block",
							"target": "self"
						}
					}
				]
			},
			"honkit26113:player_borked": {
				"sequence": [{
						"spawn_loot":{
							"table": "loot_tables/blocks/crooked_door.json"
						}
					},
					{
						"trigger": {
							"event": "honkit26113:reset_bottom",
							"target": "self"
						}
					}
				]
			},
			"honkit26113:reset_bottom": {
				"run_command": {
					"command": [
						"setblock ~~-1~ air"
					]
				}
			}
		}
	}
}