{
	"format_version": "1.20.20",
	"minecraft:block": {
		"description": {
			"identifier": "honkit26113:crooked_door_bottom",
			"menu_category": {
				"category": "none",
				"group": "none"
			},
			"states": {
				"honkit26113:is_open": [ false, true ],
				"honkit26113:direction": [ 0, 1, 2, 3 ],
				"honkit26113:top_refresh": [ false, true ],
				"honkit26113:doubledoor": [ false, true ]
			}
		},
		"components": {
      		"tag:honkit26113_dig_with_axe": {},
			"tag:honkit26113_crooked_door": {},
			"tag:wood": {},
			"minecraft:material_instances": {
				"*": {
					"texture": "crooked_door_bottom",
					"render_method": "blend",
					"face_dimming": true,
					"ambient_occlusion": false
				}
			},
			"minecraft:placement_filter": {
				"conditions": [
					{
						"allowed_faces": [ "up" ],
						"block_filter": [
							{
								"tags": "!query.any_tag('honkit26113_crooked_door')"
							}
						]
					}
				]
			},
			"minecraft:flammable": {
				"destroy_chance_modifier": 45,
				"catch_chance_modifier": 80
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 0.5
			},
			"minecraft:on_player_placing": {
				"event": "honkit26113:set_direction"
			},
			"minecraft:on_placed": {
				"event": "honkit26113:setup"
			},
			"minecraft:on_player_destroyed": {
				"event": "honkit26113:player_borked"
			},
			"minecraft:queued_ticking":{
				"interval_range": [ 5, 15 ],
				"looping": true,
                "on_tick": {
                    "event": "honkit26113:door_tick"
                }
			},
			"minecraft:geometry": { 
				"identifier": "geometry.bum_door", 
				"bone_visibility": { 
					"open": false ,
					"closed": false
				} 
			},
			"minecraft:loot": "loot_tables/no_drops.json",
			"minecraft:map_color": "#52221D",
			"minecraft:light_dampening": 0
		},
		"permutations": [
			{
				"condition": "query.block_state('honkit26113:direction') == 0",
				"components": {
					"minecraft:transformation": { "rotation": [0, 180, 0] },
					"tag:bumdir_0": {}
				}
			},
			{
				"condition": "query.block_state('honkit26113:direction') == 1",
				"components": {
					"minecraft:transformation": { "rotation": [0, 0, 0] },
					"tag:bumdir_1": {}
				}
			},
			{
				"condition": "query.block_state('honkit26113:direction') == 2",
				"components": {
					"minecraft:transformation": { "rotation": [0, 270, 0] },
					"tag:bumdir_2": {}
				}
			},
			{
				"condition": "query.block_state('honkit26113:direction') == 3",
				"components": {
					"minecraft:transformation": { "rotation": [0, 90, 0] },
					"tag:bumdir_3": {}
				}
			},
			{
				"condition": "query.block_state('honkit26113:is_open') == 0",
				"components": {
					"minecraft:on_interact": {
						"event": "honkit26113:open_door"
					},
					"minecraft:collision_box": {
						"origin": [-8, 0, -8],
						"size": [16, 16, 3]
					},
					"minecraft:selection_box": {
						"origin": [-8, 0, -8],
						"size": [16, 16, 3]
					},
					"minecraft:geometry": { 
						"identifier": "geometry.bum_door", 
						"bone_visibility": { 
							"open": false 
						} 
					},
					"tag:honkit26113:closed_crooked_door": {}
				}
			},
			{
				"condition": "query.block_state('honkit26113:is_open') == 1",
				"components": {
					"minecraft:on_interact": {
						"event": "honkit26113:close_door"
					},
					"minecraft:collision_box": {
						"origin": [-8, 0, -8],
						"size": [3, 16, 16]
					},
					"minecraft:selection_box": {
						"origin": [-8, 0, -8],
						"size": [3, 16, 16]
					},
					"minecraft:geometry": { 
						"identifier": "geometry.bum_door", 
						"bone_visibility": { 
							"closed": false
						} 
					},
					"tag:honkit26113:open_crooked_door": {}
				}
			},
			{
				"condition": "query.block_state('honkit26113:doubledoor') == true",
				"components": {
					"tag:honkit26113_door_paired": {}
				}
			}
		],
		"events": {
			"honkit26113:door_tick": {
				"sequence": [
					{
						"condition": "!q.block_neighbor_has_any_tag(0,1,0,'honkit26113_crooked_door_top')",
						"run_command": {
							"command": [
								"setblock ~~~ air"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==0",
						"trigger": {
							"event": "honkit26113:dir0_check",
							"target": "self"
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==1",
						"trigger": {
							"event": "honkit26113:dir1_check",
							"target": "self"
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==2",
						"trigger": {
							"event": "honkit26113:dir2_check",
							"target": "self"
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==3",
						"trigger": {
							"event": "honkit26113:dir3_check",
							"target": "self"
						}
					}
				]
			},
			"honkit26113:dir0_check": {
				"sequence": [
					{
						"condition": "q.block_state('honkit26113:doubledoor')==false && q.block_neighbor_has_any_tag(1,0,0,'honkit26113_crooked_door') && q.block_neighbor_has_any_tag(1,0,0,'bumdir_0') && (!q.block_neighbor_has_any_tag(1,0,0,'honkit26113_door_paired'))",
						"trigger": {
							"event": "honkit26113:init_doubledoor0",
							"target": "self"
						}
					},
					{
						"condition": "q.block_state('honkit26113:doubledoor')==true && !q.block_neighbor_has_any_tag(1,0,0,'honkit26113_crooked_door_flipped')",
						"set_block_state": {
							"honkit26113:doubledoor": false
						}
					}
				]
			},
			"honkit26113:dir1_check": {
				"sequence": [
					{
						"condition": "q.block_state('honkit26113:doubledoor')==false && q.block_neighbor_has_any_tag(-1,0,0,'honkit26113_crooked_door') && q.block_neighbor_has_any_tag(-1,0,0,'bumdir_1') && (!q.block_neighbor_has_any_tag(-1,0,0,'honkit26113_door_paired'))",
						"trigger": {
							"event": "honkit26113:init_doubledoor1",
							"target": "self"
						}
					},
					{
						"condition": "q.block_state('honkit26113:doubledoor')==true && !q.block_neighbor_has_any_tag(-1,0,0,'honkit26113_crooked_door_flipped')",
						"set_block_state": {
							"honkit26113:doubledoor": false
						}
					}
				]
			},
			"honkit26113:dir2_check": {
				"sequence": [
					{
						"condition": "q.block_state('honkit26113:doubledoor')==false && q.block_neighbor_has_any_tag(0,0,-1,'honkit26113_crooked_door') && q.block_neighbor_has_any_tag(0,0,-1,'bumdir_2') && (!q.block_neighbor_has_any_tag(0,0,-1,'honkit26113_door_paired'))",
						"trigger": {
							"event": "honkit26113:init_doubledoor2",
							"target": "self"
						}
					},
					{
						"condition": "q.block_state('honkit26113:doubledoor')==true && !q.block_neighbor_has_any_tag(0,0,-1,'honkit26113_crooked_door_flipped')",
						"set_block_state": {
							"honkit26113:doubledoor": false
						}
					}
				]
			},
			"honkit26113:dir3_check": {
				"sequence": [
					{
						"condition": "q.block_state('honkit26113:doubledoor')==false && q.block_neighbor_has_any_tag(0,0,1,'honkit26113_crooked_door') && q.block_neighbor_has_any_tag(0,0,1,'bumdir_3') && (!q.block_neighbor_has_any_tag(0,0,1,'honkit26113_door_paired'))",
						"trigger": {
							"event": "honkit26113:init_doubledoor3",
							"target": "self"
						}
					},
					{
						"condition": "q.block_state('honkit26113:doubledoor')==true && !q.block_neighbor_has_any_tag(0,0,1,'honkit26113_crooked_door_flipped')",
						"set_block_state": {
							"honkit26113:doubledoor": false
						}
					}
				]
			},
			"honkit26113:init_doubledoor0": {
				"sequence": [
					{
						"set_block_state": {
							"honkit26113:doubledoor": true
						}
					},
					{
						"run_command": {
							"command": [
								"setblock ~1~~ honkit26113:crooked_door_bottom_flipped [\"honkit26113:direction\":0, \"honkit26113:is_open\":false]"
							]
						}
					}
				]
			},
			"honkit26113:init_doubledoor1": {
				"sequence": [
					{
						"set_block_state": {
							"honkit26113:doubledoor": true
						}
					},
					{
						"run_command": {
							"command": [
								"setblock ~-1~~ honkit26113:crooked_door_bottom_flipped [\"honkit26113:direction\":1, \"honkit26113:is_open\":false]"
							]
						}
					}
				]
			},
			"honkit26113:init_doubledoor2": {
				"sequence": [
					{
						"set_block_state": {
							"honkit26113:doubledoor": true
						}
					},
					{
						"run_command": {
							"command": [
								"setblock ~~~-1 honkit26113:crooked_door_bottom_flipped [\"honkit26113:direction\":2, \"honkit26113:is_open\":false]"
							]
						}
					}
				]
			},
			"honkit26113:init_doubledoor3": {
				"sequence": [
					{
						"set_block_state": {
							"honkit26113:doubledoor": true
						}
					},
					{
						"run_command": {
							"command": [
								"setblock ~~~1 honkit26113:crooked_door_bottom_flipped [\"honkit26113:direction\":3, \"honkit26113:is_open\":false]"
							]
						}
					}
				]
			},
			"honkit26113:set_direction": {
				"sequence": [
					{
						"set_block_state": {
							"honkit26113:direction": "query.cardinal_facing_2d-2"
						}
					}
				]
			},
			"honkit26113:setup": {
				"sequence": [
					{
						"condition": "q.block_state('honkit26113:top_refresh')==false",
						"trigger": {
							"event": "honkit26113:set_upper_block",
							"target": "self"
						}
					},
					{
						"condition": "q.block_state('honkit26113:top_refresh')==true",
						"set_block_state": {
							"honkit26113:top_refresh": false
						}
					}
				]
			},
			"honkit26113:set_upper_block": {
				"sequence": [
					{
						"condition": "q.block_state('honkit26113:direction')==0&&q.block_state('honkit26113:is_open')==false",
						"run_command": {
							"command": [
								"setblock ~~1~ honkit26113:crooked_door_top [\"honkit26113:direction\"=0, \"honkit26113:is_open\"=false]"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==1&&q.block_state('honkit26113:is_open')==false",
						"run_command": {
							"command": [
								"setblock ~~1~ honkit26113:crooked_door_top [\"honkit26113:direction\"=1, \"honkit26113:is_open\"=false]"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==2&&q.block_state('honkit26113:is_open')==false",
						"run_command": {
							"command": [
								"setblock ~~1~ honkit26113:crooked_door_top [\"honkit26113:direction\"=2, \"honkit26113:is_open\"=false]"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==3&&q.block_state('honkit26113:is_open')==false",
						"run_command": {
							"command": [
								"setblock ~~1~ honkit26113:crooked_door_top [\"honkit26113:direction\"=3, \"honkit26113:is_open\"=false]"
							]
						}
					},

					{
						"condition": "q.block_state('honkit26113:direction')==0&&q.block_state('honkit26113:is_open')==true",
						"run_command": {
							"command": [
								"setblock ~~1~ honkit26113:crooked_door_top [\"honkit26113:direction\"=0, \"honkit26113:is_open\"=true]"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==1&&q.block_state('honkit26113:is_open')==true",
						"run_command": {
							"command": [
								"setblock ~~1~ honkit26113:crooked_door_top [\"honkit26113:direction\"=1, \"honkit26113:is_open\"=true]"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==2&&q.block_state('honkit26113:is_open')==true",
						"run_command": {
							"command": [
								"setblock ~~1~ honkit26113:crooked_door_top [\"honkit26113:direction\"=2, \"honkit26113:is_open\"=true]"
							]
						}
					},
					{
						"condition": "q.block_state('honkit26113:direction')==3&&q.block_state('honkit26113:is_open')==true",
						"run_command": {
							"command": [
								"setblock ~~1~ honkit26113:crooked_door_top [\"honkit26113:direction\"=3, \"honkit26113:is_open\"=true]"
							]
						}
					}
				]
			},
			"honkit26113:close_door": {
				"sequence": [{
						"run_command": {
							"command": [
								"playsound close.nether_wood_door @a[r=10] ~ ~ ~"
							]
						}
					},
					{
						"set_block_state": {
							"honkit26113:is_open": 0
						}
					},
					{
						"trigger": {
							"event": "honkit26113:set_upper_block",
							"target": "self"
						}
					}
				]
			},
			"honkit26113:open_door": {
				"sequence": [{
						"run_command": {
							"command": [
								"playsound open.nether_wood_door @a[r=10] ~ ~ ~"
							]
						}
					},
					{
						"set_block_state": {
							"honkit26113:is_open": 1
						}
					},
					{
						"trigger": {
							"event": "honkit26113:set_upper_block",
							"target": "self"
						}
					}
				]
			},
			"honkit26113:player_borked": {
				"sequence": [{
						"spawn_loot":{
							"table": "loot_tables/blocks/crooked_door.json"
						}
					},
					{
						"trigger": {
							"event": "honkit26113:reset_top",
							"target": "self"
						}
					}
				]
			},
			"honkit26113:reset_top": {
				"run_command": {
					"command": [
						"setblock ~~1~ air"
					]
				}
			}
		}
	}
}