{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "honkit26113:crystal_firefly",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:spawns_underground": {},
        "minecraft:weight": {
          "default": 20
        },
        "minecraft:herd": {
          "min_size": 2,
          "max_size": 4
        },
        "minecraft:height_filter": {
          "min": -63,
          "max": 56
        },
        "minecraft:biome_filter": [
          {
            "any_of": [
              {
                "test": "has_biome_tag",
                "operator": "==",
                "value": "plains"
              },
              {
                "all_of": [
                  {
                    "test": "has_biome_tag",
                    "operator": "==",
                    "value": "forest"
                  },
                  {
                    "test": "has_biome_tag",
                    "operator": "!=",
                    "value": "roofed"
                  },
                  {
                    "test": "has_biome_tag",
                    "operator": "!=",
                    "value": "cold"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}